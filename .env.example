# Puerto donde correrá la API
PORT=3000

# Credenciales de Azure SQL Server
DB_SERVER=servidor.database.windows.net
DB_DATABASE=estudiantes_db
DB_USER=usuario
DB_PASSWORD=password
DB_PORT=1433
